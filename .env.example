#Server
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
SERVER_RELOAD=true
#Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_HOST=localhost
DB_PORT=5432
#JWT-auth
JWT_TIMEDELTA=15
JWT_REFRESH_TIMEDELTA=7
JWT_ALGORITHM=RS256
#Logs
LOGS_DEV=False
LOGS_LEVEL=30
#Antivirus (ClamAV)
ANTIVIRUS_ENABLED=true
ANTIVIRUS_HOST=clamav
ANTIVIRUS_PORT=3310
ANTIVIRUS_TIMEOUT=60
ANTIVIRUS_FAIL_ON_UNAVAILABLE=false
ANTIVIRUS_CHUNK_SIZE=4096
#RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASSWORD=guest
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=15672
RABBITMQ_PANEL_PORT=15672
RABBITMQ_DOCUMENT_EXCHANGE_NAME=documents
RABBITMQ_EXTRACTED_ROUTING_KEY=documents.text.extracted
#Mongo
MONGO_USERNAME=root
MONGO_PASSWORD=example
MONGO_PORT=27017
MONGO_HOST=127.0.0.1
MONGO_NAME=DocMind
#Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_COMMANDER_PORT=8081
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50
#Cache
CACHE_PROMPT_TTL=3600
CACHE_USER_STATUS_TTL=3600
#Rate limiting
RATE_LIMIT_GLOBAL_LIMIT=60
RATE_LIMIT_GLOBAL_WINDOW=60
RATE_LIMIT_LOGIN_LIMIT=5
RATE_LIMIT_LOGIN_WINDOW=60
RATE_LIMIT_REGISTER_LIMIT=3
RATE_LIMIT_REGISTER_WINDOW=60
RATE_LIMIT_DOCUMENTS_POST_LIMIT=10
RATE_LIMIT_DOCUMENTS_POST_WINDOW=60
RATE_LIMIT_DOCUMENTS_GET_LIMIT=20
RATE_LIMIT_DOCUMENTS_GET_WINDOW=60
#Storage
STORAGE_BACKEND=local
#Storage Local (MinIO)
LOCAL_STORAGE_ENDPOINT_URL=http://minio:9000
LOCAL_STORAGE_ACCESS_KEY=access_key
LOCAL_STORAGE_SECRET_KEY=secret_key
LOCAL_STORAGE_REGION=us-east-1
LOCAL_STORAGE_BUCKET=docmind
LOCAL_STORAGE_PRESIGNED_URL_TTL=600
LOCAL_STORAGE_LIFECYCLE_DAYS=1
LOCAL_STORAGE_SSE_ENABLED=false
#Storage Non-local
NONLOCAL_STORAGE_ENDPOINT_URL=https://s3.selcloud.ru
NONLOCAL_STORAGE_ACCESS_KEY=access_key
NONLOCAL_STORAGE_SECRET_KEY=secret_key
NONLOCAL_STORAGE_REGION=us-east-1
NONLOCAL_STORAGE_BUCKET=docmind
NONLOCAL_STORAGE_PRESIGNED_URL_TTL=3600
NONLOCAL_STORAGE_LIFECYCLE_DAYS=30
NONLOCAL_STORAGE_SSE_ENABLED=true
#Initial Prompt
PROMPT_INITIAL_VERSION=v1.0.0
#LLM
LLM_DEFAULT_PROVIDER=deepseek
#Providers
#Kimi
KIMI_API_KEY=api_key
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=K-3
KIMI_TIMEOUT=60
KIMI_MAX_TOKENS=4096
KIMI_TEMPERATURE=0.2
#Grok
GROK_API_KEY=api_key
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4.5
GROK_TIMEOUT=60
GROK_MAX_TOKENS=4096
GROK_TEMPERATURE=0.2
#Gpt
GPT_API_KEY=api_key
GPT_BASE_URL=https://api.openai.com/v1
GPT_MODEL=gpt-5.5-2026-04-23
GPT_TIMEOUT=45
GPT_MAX_TOKENS=4096
GPT_TEMPERATURE=0.2
#Qwen
QWEN_API_KEY=api_key
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus
QWEN_TIMEOUT=60
QWEN_MAX_TOKENS=8192
QWEN_TEMPERATURE=0.15
#Mistral
MISTRAL_API_KEY=api_key
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-2603
MISTRAL_TIMEOUT=60
MISTRAL_MAX_TOKENS=4096
MISTRAL_TEMPERATURE=0.15
#Gemini
GEMINI_API_KEY=api_key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT=60
GEMINI_MAX_TOKENS=4096
GEMINI_TEMPERATURE=0.2
#DeepSeek
DEEPSEEK_API_KEY=api_key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT=60
DEEPSEEK_MAX_TOKENS=8192
DEEPSEEK_TEMPERATURE=0.2
