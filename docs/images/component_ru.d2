# DocMind component boundaries. Vertical reading order is intentional.
# Detailed individual I/O calls are in the sequence diagrams.
vars: {
  d2-config: {
    layout-engine: dagre
    pad: 28
  }
}
direction: down
style: { fill: "#0B1020" }

client: "Клиент" {
  shape: person
  style: {
    fill: "#15556A"
    stroke: "#64D9F2"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 19
    bold: true
    border-radius: 8
  }
}

api: "FastAPI · REST API\nJWT / загрузка / дедупликация\nAPI документов и анализов" {
  shape: rectangle
  style: {
    fill: "#15556A"
    stroke: "#64D9F2"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 19
    bold: true
    border-radius: 8
  }
}

file_queue: "RabbitMQ · задачи Celery" {
  shape: queue
  style: {
    fill: "#392854"
    stroke: "#C2A1FA"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 19
    bold: true
    border-radius: 8
  }
}

scan: "1 · Celery / Антивирус\nClamAV → чистый / заражённый" {
  shape: rectangle
  style: {
    fill: "#193A67"
    stroke: "#84B1FF"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 19
    bold: true
    border-radius: 8
  }
}

upload: "2 · Celery / Загрузка в S3\nФайл → S3; file_key → PostgreSQL" {
  shape: rectangle
  style: {
    fill: "#193A67"
    stroke: "#84B1FF"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 19
    bold: true
    border-radius: 8
  }
}

extract: "3 · Celery / Извлечение\nTemp / S3 fallback → текст\nDocument → extracted" {
  shape: rectangle
  style: {
    fill: "#193A67"
    stroke: "#84B1FF"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 19
    bold: true
    border-radius: 8
  }
}

analysis_queue: "RabbitMQ · AnalysisRequestedEvent" {
  shape: queue
  style: {
    fill: "#392854"
    stroke: "#C2A1FA"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 19
    bold: true
    border-radius: 8
  }
}

consumer: "FastStream · Консьюмер анализа\nЧитает текст / промпт; обновляет Analysis" {
  shape: rectangle
  style: {
    fill: "#392854"
    stroke: "#C2A1FA"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 19
    bold: true
    border-radius: 8
  }
}

llm: "LLM Factory / Провайдеры\nGPT · Gemini · DeepSeek · Kimi\nQwen · Grok · Mistral" {
  shape: rectangle
  style: {
    fill: "#563049"
    stroke: "#F1A1C9"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 19
    bold: true
    border-radius: 8
  }
}

pg: "PostgreSQL\nПользователи / Document / статус" {
  shape: cylinder
  style: {
    fill: "#163F35"
    stroke: "#66DAB6"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 17
    bold: true
    border-radius: 8
  }
}

mongo: "MongoDB\nТекст / промпты / DocumentAnalysis" {
  shape: cylinder
  style: {
    fill: "#163F35"
    stroke: "#66DAB6"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 17
    bold: true
    border-radius: 8
  }
}


# Separate infrastructure services: keep them visible, as in the original diagram.
redis: "Redis\nКэш промптов / статусов\nToken blacklist / rate limiting" {
  shape: cylinder
  style: {
    fill: "#512C32"
    stroke: "#FB8686"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 18
    bold: true
    border-radius: 8
  }
}

s3: "S3 / MinIO\nБинарные файлы\nPresigned URL" {
  shape: cylinder
  style: {
    fill: "#55401F"
    stroke: "#F9C66E"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 18
    bold: true
    border-radius: 8
  }
}

client -> api: "REST" {
  style: {
    stroke: "#64D9F2"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 15
  }
}

api -> file_queue: "FULL / EXTRACTION" {
  style: {
    stroke: "#C2A1FA"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 15
  }
}

file_queue -> scan: "новый файл; AV опционален" {
  style: {
    stroke: "#84B1FF"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 15
  }
}

scan -> upload: "чистый; через RabbitMQ" {
  style: {
    stroke: "#84B1FF"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 15
  }
}

upload -> extract: "uploaded; через RabbitMQ" {
  style: {
    stroke: "#84B1FF"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 15
  }
}

extract -> analysis_queue: "создать Analysis queued + событие" {
  style: {
    stroke: "#C2A1FA"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 15
  }
}

analysis_queue -> consumer: "получить событие" {
  style: {
    stroke: "#C2A1FA"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 15
  }
}

consumer -> llm: "текст + промпт" {
  style: {
    stroke: "#F1A1C9"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 15
  }
}

api -> pg: "метаданные" {
  style: {
    stroke: "#66DAB6"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 15
  }
}

extract -> mongo: "сохранить текст" {
  style: {
    stroke: "#66DAB6"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 15
  }
}

consumer -> mongo: "статус / результат анализа" {
  style: {
    stroke: "#66DAB6"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 15
  }
}

api -> analysis_queue: "ANALYSIS_ONLY · минуя Celery" {
  style: {
    stroke: "#C2A1FA"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 15
  }
}


# PostgreSQL owns Document state; MongoDB owns raw text and Analysis.
# Infrastructure connections (independent nodes, not text inside worker blocks).
api -> redis: "кэш / blacklist / лимиты" {
  style: {
    stroke: "#FB8686"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 14
  }
}

consumer -> redis: "кэш активного промпта" {
  style: {
    stroke: "#FB8686"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 14
  }
}

api -> s3: "presigned URL" {
  style: {
    stroke: "#F9C66E"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 14
  }
}

upload -> s3: "загрузка файла" {
  style: {
    stroke: "#F9C66E"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 14
  }
}

extract -> s3: "fallback, если нет temp-файла" {
  style: {
    stroke: "#F9C66E"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 14
  }
}

