# Dark, high-contrast component diagram. No external theme required.
# ELK keeps the multi-service flow readable; the background is explicitly set.
vars: {
  d2-config: {
    layout-engine: elk
    pad: 60
  }
}
direction: right
style: {
  fill: "#0B1020"
}

client: "Клиент" {
  shape: person
  style: {
    fill: "#123E52"
    stroke: "#4CCFEA"
    stroke-width: 3
    font-color: "#F3F8FF"
    font-size: 20
    bold: true
    border-radius: 8
  }
}

api: "FastAPI\nREST · JWT · дедупликация" {
  shape: rectangle
  style: {
    fill: "#123E52"
    stroke: "#4CCFEA"
    stroke-width: 3
    font-color: "#F3F8FF"
    font-size: 20
    bold: true
    border-radius: 8
  }
}

broker: "RabbitMQ\nЗадачи Celery · события анализа" {
  shape: queue
  style: {
    fill: "#41305F"
    stroke: "#BD96FA"
    stroke-width: 3
    font-color: "#F3F8FF"
    font-size: 20
    bold: true
    border-radius: 8
  }
}

workers: "Celery workers\nАнтивирус · S3 · извлечение текста" {
  shape: rectangle
  style: {
    fill: "#213C64"
    stroke: "#7AA8FF"
    stroke-width: 3
    font-color: "#F3F8FF"
    font-size: 20
    bold: true
    border-radius: 8
  }
}

consumer: "FastStream\nКонсьюмер анализа" {
  shape: rectangle
  style: {
    fill: "#41305F"
    stroke: "#BD96FA"
    stroke-width: 3
    font-color: "#F3F8FF"
    font-size: 20
    bold: true
    border-radius: 8
  }
}

llm: "LLM-провайдеры\nGPT · Gemini · DeepSeek · Kimi · Qwen · Grok · Mistral" {
  shape: rectangle
  style: {
    fill: "#59314B"
    stroke: "#F29AC3"
    stroke-width: 3
    font-color: "#F3F8FF"
    font-size: 20
    bold: true
    border-radius: 8
  }
}

temp: "Общий temp volume\nAPI + Celery · один хост" {
  shape: stored_data
  style: {
    fill: "#243249"
    stroke: "#B0C3DE"
    stroke-width: 3
    font-color: "#F3F8FF"
    font-size: 20
    bold: true
    border-radius: 8
  }
}

clam: "ClamAV\nАнтивирусная проверка" {
  shape: rectangle
  style: {
    fill: "#564026"
    stroke: "#F5B85B"
    stroke-width: 3
    font-color: "#F3F8FF"
    font-size: 20
    bold: true
    border-radius: 8
  }
}

pg: "PostgreSQL\nDocument → extracted" {
  shape: cylinder
  style: {
    fill: "#163E35"
    stroke: "#55DCB0"
    stroke-width: 3
    font-color: "#F3F8FF"
    font-size: 20
    bold: true
    border-radius: 8
  }
}

mongo: "MongoDB\nТекст · промпты · DocumentAnalysis" {
  shape: cylinder
  style: {
    fill: "#163E35"
    stroke: "#55DCB0"
    stroke-width: 3
    font-color: "#F3F8FF"
    font-size: 20
    bold: true
    border-radius: 8
  }
}

s3: "S3 / MinIO\nДолговременное хранение" {
  shape: cylinder
  style: {
    fill: "#163E35"
    stroke: "#55DCB0"
    stroke-width: 3
    font-color: "#F3F8FF"
    font-size: 20
    bold: true
    border-radius: 8
  }
}

redis: "Redis\nКэш · blacklist · rate limiting" {
  shape: cylinder
  style: {
    fill: "#564026"
    stroke: "#F5B85B"
    stroke-width: 3
    font-color: "#F3F8FF"
    font-size: 20
    bold: true
    border-radius: 8
  }
}

# Colored connections; short labels prevent overcrowding.
client -> api: "HTTPS / JWT" {
  style: {
    stroke: "#4CCFEA"
    stroke-width: 3
    font-color: "#D6E5F5"
    font-size: 15
  }
}

api -> broker: "Задачи / события" {
  style: {
    stroke: "#BD96FA"
    stroke-width: 3
    font-color: "#D6E5F5"
    font-size: 15
  }
}

broker -> workers: "Задачи Celery" {
  style: {
    stroke: "#7AA8FF"
    stroke-width: 3
    font-color: "#D6E5F5"
    font-size: 15
  }
}

workers -> broker: "След. задача / событие" {
  style: {
    stroke: "#BD96FA"
    stroke-width: 3
    font-color: "#D6E5F5"
    font-size: 15
  }
}

broker -> consumer: "AnalysisRequestedEvent" {
  style: {
    stroke: "#BD96FA"
    stroke-width: 3
    font-color: "#D6E5F5"
    font-size: 15
  }
}

consumer -> llm: "Текст + промпт" {
  style: {
    stroke: "#F29AC3"
    stroke-width: 3
    font-color: "#D6E5F5"
    font-size: 15
  }
}

api -> temp: "Сохранение файла" {
  style: {
    stroke: "#B0C3DE"
    stroke-width: 3
    font-color: "#D6E5F5"
    font-size: 15
  }
}

workers -> temp: "Чтение / удаление" {
  style: {
    stroke: "#B0C3DE"
    stroke-width: 3
    font-color: "#D6E5F5"
    font-size: 15
  }
}

workers -> clam: "Проверка" {
  style: {
    stroke: "#F5B85B"
    stroke-width: 3
    font-color: "#D6E5F5"
    font-size: 15
  }
}

workers -> s3: "Загрузка / fallback" {
  style: {
    stroke: "#55DCB0"
    stroke-width: 3
    font-color: "#D6E5F5"
    font-size: 15
  }
}

api -> s3: "Presigned URL" {
  style: {
    stroke: "#55DCB0"
    stroke-width: 3
    font-color: "#D6E5F5"
    font-size: 15
  }
}

api -> pg: "Метаданные" {
  style: {
    stroke: "#55DCB0"
    stroke-width: 3
    font-color: "#D6E5F5"
    font-size: 15
  }
}

workers -> pg: "Статус Document" {
  style: {
    stroke: "#55DCB0"
    stroke-width: 3
    font-color: "#D6E5F5"
    font-size: 15
  }
}

api -> mongo: "API анализов" {
  style: {
    stroke: "#55DCB0"
    stroke-width: 3
    font-color: "#D6E5F5"
    font-size: 15
  }
}

workers -> mongo: "Текст + queued Analysis" {
  style: {
    stroke: "#55DCB0"
    stroke-width: 3
    font-color: "#D6E5F5"
    font-size: 15
  }
}

consumer -> mongo: "Статус + результат Analysis" {
  style: {
    stroke: "#55DCB0"
    stroke-width: 3
    font-color: "#D6E5F5"
    font-size: 15
  }
}

api -> redis: "Токены + лимиты" {
  style: {
    stroke: "#F5B85B"
    stroke-width: 3
    font-color: "#D6E5F5"
    font-size: 15
  }
}

consumer -> redis: "Кэш промптов" {
  style: {
    stroke: "#F5B85B"
    stroke-width: 3
    font-color: "#D6E5F5"
    font-size: 15
  }
}
