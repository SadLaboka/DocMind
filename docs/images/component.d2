# Dark, high-contrast component diagram. No external theme required.
# ELK keeps the multi-service flow readable; the background is explicitly set.
vars: {
  d2-config: {
    layout-engine: elk
    pad: 60
  }
}
direction: right
style: {
  fill: "#0B1020"
}

client: "Client" {
  shape: person
  style: {
    fill: "#123E52"
    stroke: "#4CCFEA"
    stroke-width: 3
    font-color: "#F3F8FF"
    font-size: 20
    bold: true
    border-radius: 8
  }
}

api: "FastAPI\nREST · JWT · deduplication" {
  shape: rectangle
  style: {
    fill: "#123E52"
    stroke: "#4CCFEA"
    stroke-width: 3
    font-color: "#F3F8FF"
    font-size: 20
    bold: true
    border-radius: 8
  }
}

broker: "RabbitMQ\nCelery tasks · analysis events" {
  shape: queue
  style: {
    fill: "#41305F"
    stroke: "#BD96FA"
    stroke-width: 3
    font-color: "#F3F8FF"
    font-size: 20
    bold: true
    border-radius: 8
  }
}

workers: "Celery workers\nScan · S3 upload · extraction" {
  shape: rectangle
  style: {
    fill: "#213C64"
    stroke: "#7AA8FF"
    stroke-width: 3
    font-color: "#F3F8FF"
    font-size: 20
    bold: true
    border-radius: 8
  }
}

consumer: "FastStream\nAnalysis consumer" {
  shape: rectangle
  style: {
    fill: "#41305F"
    stroke: "#BD96FA"
    stroke-width: 3
    font-color: "#F3F8FF"
    font-size: 20
    bold: true
    border-radius: 8
  }
}

llm: "LLM providers\nGPT · Gemini · DeepSeek · Kimi · Qwen · Grok · Mistral" {
  shape: rectangle
  style: {
    fill: "#59314B"
    stroke: "#F29AC3"
    stroke-width: 3
    font-color: "#F3F8FF"
    font-size: 20
    bold: true
    border-radius: 8
  }
}

temp: "Shared temp volume\nAPI + Celery · single host" {
  shape: stored_data
  style: {
    fill: "#243249"
    stroke: "#B0C3DE"
    stroke-width: 3
    font-color: "#F3F8FF"
    font-size: 20
    bold: true
    border-radius: 8
  }
}

clam: "ClamAV\nAntivirus scan" {
  shape: rectangle
  style: {
    fill: "#564026"
    stroke: "#F5B85B"
    stroke-width: 3
    font-color: "#F3F8FF"
    font-size: 20
    bold: true
    border-radius: 8
  }
}

pg: "PostgreSQL\nDocument → extracted" {
  shape: cylinder
  style: {
    fill: "#163E35"
    stroke: "#55DCB0"
    stroke-width: 3
    font-color: "#F3F8FF"
    font-size: 20
    bold: true
    border-radius: 8
  }
}

mongo: "MongoDB\nRaw text · prompts · DocumentAnalysis" {
  shape: cylinder
  style: {
    fill: "#163E35"
    stroke: "#55DCB0"
    stroke-width: 3
    font-color: "#F3F8FF"
    font-size: 20
    bold: true
    border-radius: 8
  }
}

s3: "S3 / MinIO\nDurable file storage" {
  shape: cylinder
  style: {
    fill: "#163E35"
    stroke: "#55DCB0"
    stroke-width: 3
    font-color: "#F3F8FF"
    font-size: 20
    bold: true
    border-radius: 8
  }
}

redis: "Redis\nCache · token blacklist · rate limiting" {
  shape: cylinder
  style: {
    fill: "#564026"
    stroke: "#F5B85B"
    stroke-width: 3
    font-color: "#F3F8FF"
    font-size: 20
    bold: true
    border-radius: 8
  }
}

# Colored connections; short labels prevent overcrowding.
client -> api: "HTTPS / JWT" {
  style: {
    stroke: "#4CCFEA"
    stroke-width: 3
    font-color: "#D6E5F5"
    font-size: 15
  }
}

api -> broker: "Enqueue task / event" {
  style: {
    stroke: "#BD96FA"
    stroke-width: 3
    font-color: "#D6E5F5"
    font-size: 15
  }
}

broker -> workers: "Celery tasks" {
  style: {
    stroke: "#7AA8FF"
    stroke-width: 3
    font-color: "#D6E5F5"
    font-size: 15
  }
}

workers -> broker: "Next tasks / analysis event" {
  style: {
    stroke: "#BD96FA"
    stroke-width: 3
    font-color: "#D6E5F5"
    font-size: 15
  }
}

broker -> consumer: "AnalysisRequestedEvent" {
  style: {
    stroke: "#BD96FA"
    stroke-width: 3
    font-color: "#D6E5F5"
    font-size: 15
  }
}

consumer -> llm: "Text + prompt" {
  style: {
    stroke: "#F29AC3"
    stroke-width: 3
    font-color: "#D6E5F5"
    font-size: 15
  }
}

api -> temp: "Save upload" {
  style: {
    stroke: "#B0C3DE"
    stroke-width: 3
    font-color: "#D6E5F5"
    font-size: 15
  }
}

workers -> temp: "Read / cleanup" {
  style: {
    stroke: "#B0C3DE"
    stroke-width: 3
    font-color: "#D6E5F5"
    font-size: 15
  }
}

workers -> clam: "Scan" {
  style: {
    stroke: "#F5B85B"
    stroke-width: 3
    font-color: "#D6E5F5"
    font-size: 15
  }
}

workers -> s3: "Upload / restore" {
  style: {
    stroke: "#55DCB0"
    stroke-width: 3
    font-color: "#D6E5F5"
    font-size: 15
  }
}

api -> s3: "Presigned URL" {
  style: {
    stroke: "#55DCB0"
    stroke-width: 3
    font-color: "#D6E5F5"
    font-size: 15
  }
}

api -> pg: "Metadata" {
  style: {
    stroke: "#55DCB0"
    stroke-width: 3
    font-color: "#D6E5F5"
    font-size: 15
  }
}

workers -> pg: "Document status" {
  style: {
    stroke: "#55DCB0"
    stroke-width: 3
    font-color: "#D6E5F5"
    font-size: 15
  }
}

api -> mongo: "Analysis API" {
  style: {
    stroke: "#55DCB0"
    stroke-width: 3
    font-color: "#D6E5F5"
    font-size: 15
  }
}

workers -> mongo: "Raw text + queued Analysis" {
  style: {
    stroke: "#55DCB0"
    stroke-width: 3
    font-color: "#D6E5F5"
    font-size: 15
  }
}

consumer -> mongo: "Analysis status + result" {
  style: {
    stroke: "#55DCB0"
    stroke-width: 3
    font-color: "#D6E5F5"
    font-size: 15
  }
}

api -> redis: "Tokens + limits" {
  style: {
    stroke: "#F5B85B"
    stroke-width: 3
    font-color: "#D6E5F5"
    font-size: 15
  }
}

consumer -> redis: "Prompt cache" {
  style: {
    stroke: "#F5B85B"
    stroke-width: 3
    font-color: "#D6E5F5"
    font-size: 15
  }
}
