# DocMind component boundaries. Vertical reading order is intentional.
# Detailed individual I/O calls are in the sequence diagrams.
vars: {
  d2-config: {
    layout-engine: dagre
    pad: 28
  }
}
direction: down
style: { fill: "#0B1020" }

client: "Client" {
  shape: person
  style: {
    fill: "#15556A"
    stroke: "#64D9F2"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 19
    bold: true
    border-radius: 8
  }
}

api: "FastAPI · REST API\nJWT / upload / dedup\nDocument + Analysis endpoints" {
  shape: rectangle
  style: {
    fill: "#15556A"
    stroke: "#64D9F2"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 19
    bold: true
    border-radius: 8
  }
}

file_queue: "RabbitMQ · Celery tasks" {
  shape: queue
  style: {
    fill: "#392854"
    stroke: "#C2A1FA"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 19
    bold: true
    border-radius: 8
  }
}

scan: "1 · Celery / Antivirus\nClamAV → clean or infected" {
  shape: rectangle
  style: {
    fill: "#193A67"
    stroke: "#84B1FF"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 19
    bold: true
    border-radius: 8
  }
}

upload: "2 · Celery / S3 Upload\nBinary → S3; file_key → PostgreSQL" {
  shape: rectangle
  style: {
    fill: "#193A67"
    stroke: "#84B1FF"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 19
    bold: true
    border-radius: 8
  }
}

extract: "3 · Celery / Extraction\nTemp / S3 fallback → raw text\nDocument → extracted" {
  shape: rectangle
  style: {
    fill: "#193A67"
    stroke: "#84B1FF"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 19
    bold: true
    border-radius: 8
  }
}

analysis_queue: "RabbitMQ · AnalysisRequestedEvent" {
  shape: queue
  style: {
    fill: "#392854"
    stroke: "#C2A1FA"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 19
    bold: true
    border-radius: 8
  }
}

consumer: "FastStream · Analysis Consumer\nRead text / prompt; update Analysis" {
  shape: rectangle
  style: {
    fill: "#392854"
    stroke: "#C2A1FA"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 19
    bold: true
    border-radius: 8
  }
}

llm: "LLM Factory / Providers\nGPT · Gemini · DeepSeek · Kimi\nQwen · Grok · Mistral" {
  shape: rectangle
  style: {
    fill: "#563049"
    stroke: "#F1A1C9"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 19
    bold: true
    border-radius: 8
  }
}

pg: "PostgreSQL\nUsers / Document / file_key / status" {
  shape: cylinder
  style: {
    fill: "#163F35"
    stroke: "#66DAB6"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 17
    bold: true
    border-radius: 8
  }
}

mongo: "MongoDB\nRaw text / prompts / DocumentAnalysis" {
  shape: cylinder
  style: {
    fill: "#163F35"
    stroke: "#66DAB6"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 17
    bold: true
    border-radius: 8
  }
}


# Separate infrastructure services: keep them visible, as in the original diagram.
redis: "Redis\nPrompt / user caches\nToken blacklist / rate limiting" {
  shape: cylinder
  style: {
    fill: "#512C32"
    stroke: "#FB8686"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 18
    bold: true
    border-radius: 8
  }
}

s3: "S3 / MinIO\nBinary files\nPresigned URLs" {
  shape: cylinder
  style: {
    fill: "#55401F"
    stroke: "#F9C66E"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 18
    bold: true
    border-radius: 8
  }
}

client -> api: "REST" {
  style: {
    stroke: "#64D9F2"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 15
  }
}

api -> file_queue: "FULL / EXTRACTION" {
  style: {
    stroke: "#C2A1FA"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 15
  }
}

file_queue -> scan: "new content; AV optional" {
  style: {
    stroke: "#84B1FF"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 15
  }
}

scan -> upload: "clean; via RabbitMQ" {
  style: {
    stroke: "#84B1FF"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 15
  }
}

upload -> extract: "uploaded; via RabbitMQ" {
  style: {
    stroke: "#84B1FF"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 15
  }
}

extract -> analysis_queue: "create queued Analysis + event" {
  style: {
    stroke: "#C2A1FA"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 15
  }
}

analysis_queue -> consumer: "consume event" {
  style: {
    stroke: "#C2A1FA"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 15
  }
}

consumer -> llm: "text + prompt" {
  style: {
    stroke: "#F1A1C9"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 15
  }
}

api -> pg: "metadata" {
  style: {
    stroke: "#66DAB6"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 15
  }
}

extract -> mongo: "save raw text" {
  style: {
    stroke: "#66DAB6"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 15
  }
}

consumer -> mongo: "analysis status / result" {
  style: {
    stroke: "#66DAB6"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 15
  }
}

api -> analysis_queue: "ANALYSIS_ONLY · bypass Celery" {
  style: {
    stroke: "#C2A1FA"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 15
  }
}


# PostgreSQL owns Document state; MongoDB owns raw text and Analysis.
# Infrastructure connections (independent nodes, not text inside worker blocks).
api -> redis: "cache / blacklist / limits" {
  style: {
    stroke: "#FB8686"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 14
  }
}

consumer -> redis: "active prompt cache" {
  style: {
    stroke: "#FB8686"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 14
  }
}

api -> s3: "presigned URL" {
  style: {
    stroke: "#F9C66E"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 14
  }
}

upload -> s3: "upload file" {
  style: {
    stroke: "#F9C66E"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 14
  }
}

extract -> s3: "fallback if temp is missing" {
  style: {
    stroke: "#F9C66E"
    stroke-width: 3
    font-color: "#F1F6FF"
    font-size: 14
  }
}

